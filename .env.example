# ---------------------------------------------------------------------------
# Raymond Developers — environment variables
#
# Copy to .env.local for development. .env* is gitignored; the only file that
# belongs in the repo is this example, which must never contain real values.
#
# Hosting is billed by direct bank transfer. The invoice job needs somewhere
# to read those bank details from in order to put them in an email, so — one
# deliberate exception to the usual rule — they live below as env vars. They
# are never written into source code, never committed, and never sent to the
# browser. See the security note in README.md.
# ---------------------------------------------------------------------------

# --- Site ------------------------------------------------------------------
# Canonical origin, no trailing slash. Locally: http://localhost:3000
NEXT_PUBLIC_SITE_URL=https://raymonddevelopers.co.uk

# --- Admin login (/admin) --------------------------------------------------
# The single admin account. Generate the hash and a session secret with:
#   npm run hash-password
# The plain password is never stored anywhere — only the scrypt hash below.
ADMIN_EMAIL=abdulrahmanammad7@gmail.com
ADMIN_PASSWORD_HASH=scrypt:replace:me
SESSION_SECRET=replace_me_with_a_long_random_string

# --- Client storage (Upstash Redis) ----------------------------------------
# Create a free database at https://console.upstash.com (or add the Upstash
# integration from the Vercel marketplace, which sets these automatically).
# Copy the REST URL and REST token — not the Redis connection string.
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=replace_me

# --- Sending email ---------------------------------------------------------
# Used for invoices, reminders and final notices. Any SMTP provider works —
# Gmail with an app password, your domain's mailbox, Zoho, etc.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=you@raymonddevelopers.co.uk
SMTP_PASS=replace_me
SMTP_FROM=you@raymonddevelopers.co.uk

# --- Invoice job -----------------------------------------------------------
# Vercel sends `Authorization: Bearer <CRON_SECRET>` when it triggers the
# daily job, once this is set. Use a long random string.
CRON_SECRET=replace_me_with_a_long_random_string

# Stated on every invoice, reminder and final notice.
BANK_ACCOUNT_NAME=Raymond Developers
BANK_SORT_CODE=00-00-00
BANK_ACCOUNT_NUMBER=00000000

# --- Automatic hosting suspension (Vercel API) ------------------------------
# Optional. Without it, day-15 overdue clients still get flagged and emailed
# a final notice, but the site has to be taken down/restored by hand as
# before. With it, the daily job unassigns the client's domain from their
# Vercel project automatically, and "Mark paid" in /admin reassigns it.
#
# Create a token at https://vercel.com/account/tokens. Each client also needs
# their Vercel project ID (Project → Settings → General) entered in /admin.
VERCEL_TOKEN=replace_me
# Only needed if the client projects live under a Vercel team rather than
# your personal account — use one or the other, not both.
# VERCEL_TEAM_ID=team_xxxxxxxx
# VERCEL_TEAM_SLUG=your-team-slug
